#!/usr/bin/env bash
set -euo pipefail

export COMPOSE_DOCKER_CLI_BUILD=1
export DOCKER_BUILDKIT=1
BASE_DIR="/home/{{ deploy_user }}/{{ supabase_path }}"

# The log drain (Logflare + Vector) ships in a separate docker-compose-logs.yml
# override. It is started only when log_drain_enabled is true (config.yml
# required.enable_logging). The override file is always rendered so that `down`
# below also tears down orphaned analytics/vector containers when the drain is
# disabled (docker compose -f base down alone would leave them running).
COMPOSE="docker compose -f $BASE_DIR/docker-compose-supabase.yml{{ ' -f $BASE_DIR/docker-compose-logs.yml' if log_drain_enabled | default(false) | bool else '' }}"
COMPOSE_DOWN="docker compose -f $BASE_DIR/docker-compose-supabase.yml"
[ -f "$BASE_DIR/docker-compose-logs.yml" ] && COMPOSE_DOWN="$COMPOSE_DOWN -f $BASE_DIR/docker-compose-logs.yml"

$COMPOSE_DOWN down
$COMPOSE up -d || true

echo "Waiting for Supabase services to become healthy..."
TIMEOUT=600
ELAPSED=0
while [ $ELAPSED -lt $TIMEOUT ]; do
  TOTAL=$($COMPOSE ps --format json 2>/dev/null | grep -c '.' || true)
  HEALTHY=$($COMPOSE ps --format json 2>/dev/null | grep -c '"Health":"healthy"' || true)

  echo "  Services: $HEALTHY/$TOTAL healthy (${ELAPSED}s/${TIMEOUT}s)"

  if [ "$TOTAL" -gt 0 ] && [ "$HEALTHY" -eq "$TOTAL" ]; then
    echo "All $TOTAL services healthy."
    exit 0
  fi

  sleep 10
  ELAPSED=$((ELAPSED + 10))
done

echo "ERROR: Timed out waiting for services after ${TIMEOUT}s"
$COMPOSE ps
exit 1
