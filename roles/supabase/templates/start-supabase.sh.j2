#!/usr/bin/env bash
set -euo pipefail

export COMPOSE_DOCKER_CLI_BUILD=1
export DOCKER_BUILDKIT=1
COMPOSE="docker compose -f /home/{{ deploy_user }}/{{ supabase_path }}/docker-compose-supabase.yml"

$COMPOSE down
$COMPOSE up -d || true

echo "Waiting for Supabase services to become healthy..."
TIMEOUT=600
ELAPSED=0
while [ $ELAPSED -lt $TIMEOUT ]; do
  TOTAL=$($COMPOSE ps --format json 2>/dev/null | grep -c '.' || true)
  HEALTHY=$($COMPOSE ps --format json 2>/dev/null | grep -c '"Health":"healthy"' || true)

  echo "  Services: $HEALTHY/$TOTAL healthy (${ELAPSED}s/${TIMEOUT}s)"

  if [ "$TOTAL" -gt 0 ] && [ "$HEALTHY" -eq "$TOTAL" ]; then
    echo "All $TOTAL services healthy."
    exit 0
  fi

  sleep 10
  ELAPSED=$((ELAPSED + 10))
done

echo "ERROR: Timed out waiting for services after ${TIMEOUT}s"
$COMPOSE ps
exit 1
