#!/bin/sh
# Managed by Ansible — do not edit manually.
# On-demand differential backup: pgbackrest --stanza=main backup --type=diff
set -eu

CONTAINER="supabase-pgbackrest{{ '-' + deploy_env if deploy_env != 'changeit' else '' }}"
STANZA="{{ backup_stanza_name }}"

echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Starting differential backup..."
docker exec "$CONTAINER" pgbackrest --stanza="$STANZA" --type=diff --log-level-console=info backup
rc=$?
if [ $rc -ne 0 ]; then
  echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] ERROR: differential backup failed (exit $rc)" >&2
  exit $rc
fi
echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Differential backup completed."
docker exec "$CONTAINER" pgbackrest --stanza="$STANZA" expire
echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Retention applied."