#!/bin/sh
# Managed by Ansible — do not edit manually.
# Daily repo integrity check: pgbackrest verify
# This is a cheap checksum + size audit of repo files. It does NOT prove
# Postgres can start from the restored data — that's the restore drill.
set -eu

CONTAINER="supabase-pgbackrest{{ '-' + deploy_env if deploy_env != 'changeit' else '' }}"
STANZA="{{ backup_stanza_name }}"

echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Starting repo verify..."
docker exec "$CONTAINER" pgbackrest --stanza="$STANZA" --output=text --log-level-console=info verify
rc=$?
if [ $rc -ne 0 ]; then
  echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] ERROR: verify failed (exit $rc) — repo integrity compromised" >&2
  exit $rc
fi
echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] Verify passed."