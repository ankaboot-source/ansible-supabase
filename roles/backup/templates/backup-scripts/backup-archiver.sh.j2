#!/bin/sh
# Managed by Ansible — do not edit manually.
# WAL archiver sidecar: watches a shared spool directory for WAL files written
# by the db container's archive_command (cp) and pushes them to the pgBackRest
# repo via archive-push. This replaces the fragile docker-socket approach.
#
# The db container writes WAL to:  /var/spool/pgbackrest/in/%f  (via archive_command)
# This script processes files from the spool and pushes to the repo.
set -eu

STANZA="{{ backup_stanza_name }}"
SPOOL_IN="/var/spool/pgbackrest/in"
SPOOL_FAILED="/var/spool/pgbackrest/failed"
MAX_RETRIES=3

mkdir -p "$SPOOL_IN" "$SPOOL_FAILED"

echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] [archiver] starting; watching $SPOOL_IN for WAL files"

while true; do
  found=0
  for f in "$SPOOL_IN"/*; do
    [ -e "$f" ] || continue
    found=1
    fname="$(basename "$f")"
    retry_count=0

    # Retry loop — up to MAX_RETRIES attempts per file
    while [ $retry_count -lt $MAX_RETRIES ]; do
      if pgbackrest --stanza="$STANZA" --log-level-console=info archive-push "$f"; then
        rm -f "$f"
        echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] [archiver] pushed $fname"
        break
      else
        retry_count=$((retry_count + 1))
        echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] [archiver] archive-push failed for $fname (attempt $retry_count/$MAX_RETRIES)" >&2
        if [ $retry_count -ge $MAX_RETRIES ]; then
          mv "$f" "$SPOOL_FAILED/" 2>/dev/null || true
          echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] [archiver] moved $fname to failed/ after $MAX_RETRIES attempts" >&2
        else
          sleep 2
        fi
      fi
    done
  done

  # Also retry failed files periodically (every 60s)
  for f in "$SPOOL_FAILED"/*; do
    [ -e "$f" ] || continue
    fname="$(basename "$f")"
    if pgbackrest --stanza="$STANZA" --log-level-console=info archive-push "$f"; then
      rm -f "$f"
      echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] [archiver] re-pushed failed file $fname"
    fi
  done

  sleep 5
done
