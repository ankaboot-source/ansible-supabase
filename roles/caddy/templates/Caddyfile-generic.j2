{% if projects.values() | selectattr('oidc_enabled') | list | length > 0 %}
{
    order authenticate before respond
    order authorize before basic_auth

    security {
        oauth identity provider {{ oidc_driver }} {
            realm {{ oidc_realm }}
            driver {{ oidc_driver }}
            client_id {{ oidc_client_id }}
            client_secret {{ oidc_client_secret }}
            scopes openid email profile
            base_auth_url {{ base_auth_url }}
            metadata_url {{ metadata_url }}
        }

        authentication portal myportal {
            crypto default token lifetime 3600
            crypto key sign-verify {env.JWT_SHARED_KEY}
            enable identity provider {{ oidc_driver }}
            cookie domain {{ root_domain }}

            ui {
                links {
                    "My Identity" "/whoami" icon "las la-user"
                }
            }

            transform user {
                match realm generic
                action add role authp/user
                ui link "File Server" {{ app_url }} icon "las la-star"
            }

            transform user {
                match realm {{ oidc_realm }}
                match email {{ generic_allow_list }}
                action add role authp/admin
            }
        }

        authorization policy mypolicy {
            set auth url https://{{ base_auth_domain }}/oauth2/{{ oidc_driver }}
            crypto key verify {env.JWT_SHARED_KEY}
            allow roles authp/admin
            validate bearer header
            inject headers with claims
        }
    }
}

https://{{ base_auth_domain }} {
{% if caddy_tls_internal | default(false) %}
    # CI/offline mode: issue from Caddy's own local CA instead of ACME,
    # which needs a publicly resolvable name. Never set in production.
    tls internal
{% endif %}
    log {
        output file /var/log/caddy/caddy-auth.log {
            roll_size 10MiB
            roll_keep 10
            roll_keep_for 24h
        }
    }

    authenticate with myportal
}
{% endif %}

{% for project, cfg in projects.items() %}
https://{{ cfg.domain }} {
{% if caddy_tls_internal | default(false) %}
    # CI/offline mode: issue from Caddy's own local CA instead of ACME,
    # which needs a publicly resolvable name. Never set in production.
    tls internal
{% endif %}

    log {
        output file /var/log/caddy/{{ cfg.log_file }}.log {
            roll_size 10MiB
            roll_keep 10
            roll_keep_for 24h
        }
    }

    {% if cfg.allowed_ips is defined and cfg.allowed_ips | length > 0 %}
      @allowedIPs {
          {% for ip in cfg.allowed_ips %}
          remote_ip {{ ip }}
          {% endfor %}
      }

        handle @allowedIPs {
    {% endif %}
    {% for upstream in cfg.upstreams %}
        {% if upstream.basicauth is defined %}
            {% for rule in upstream.basicauth %}
                handle {{ rule.path }} {
                    basic_auth {
                        {{ rule.username }} {{ rule.password }}
                    }
                    {% if upstream.oidc %}
                        authorize with mypolicy
                    {% endif %}

                    reverse_proxy {{ upstream.targets | join(" ") }}
                }
            {% endfor %}
        {% endif %}

        {% if upstream.paths is defined %}
            {% for path in upstream.paths %}
                handle {{ path }} {
                    {% if upstream.oidc %}
                        authorize with mypolicy
                    {% endif %}

                    reverse_proxy {{ upstream.targets | join(" ") }}
                }
            {% endfor %}
        {% endif %}
    {% endfor %}

    {% if cfg.allowed_ips is defined and cfg.allowed_ips | length > 0 %}
        }
        # Deny all other IPs
        handle {
            respond "Forbidden" 403
        }
    {% endif %}
}
{% endfor %}